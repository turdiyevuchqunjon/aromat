# ====== SAYT ======
NEXT_PUBLIC_SITE_URL=https://aromalux.uz
NEXT_PUBLIC_CURRENCY=UZS

# ====== META PIXEL / CONVERSIONS API (CAPI) ======
# Meta Events Manager -> Data Sources -> Pixel -> Settings ichidan olinadi
NEXT_PUBLIC_FB_PIXEL_ID=
# Events Manager -> Conversions API -> Generate access token
FB_CAPI_ACCESS_TOKEN=
# Test qilish uchun (Events Manager -> Test Events bo'limidagi kod). Productionda bo'sh qoldiring.
FB_TEST_EVENT_CODE=

# ====== TELEGRAM BOT ======
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=
# Lidlar tushadigan chat/kanal ID (o'zingizning shaxsiy chat ID yoki guruh ID)
TELEGRAM_CHAT_ID=
# Rahmat sahifasidan 10 soniyadan keyin mijoz shu profilga/botga yo'naltiriladi (masalan: aromalux_admin)
# Brauzerda ishlatilgani uchun NEXT_PUBLIC_ prefiksi bilan
NEXT_PUBLIC_TELEGRAM_REDIRECT_USERNAME=aromalux_admin

# ====== XARID HAVOLASI ======
# Purchase havolasidagi lid ma'lumotlarini shifrlash kaliti (openssl rand -hex 32). O'zgartirsangiz eski havolalar ishlamay qoladi.
LEAD_LINK_SECRET=
